# ── RAG microservice configuration ─────────────────────────────────────────────
# Same PostgreSQL database the Express server uses (pgvector extension enabled)
RAG_DB_URL=postgresql+psycopg://user:password@localhost:5432/sandarbh

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxx

# Models
RAG_LLM_MODEL=openai/gpt-4o-mini
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small

# Shared secret the Express server sends as X-Service-Secret (keep it strong)
RAG_SERVICE_SECRET=change-me-to-a-long-random-string

# Chunking / retrieval tuning
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MAX_FILE_SIZE_MB=100
